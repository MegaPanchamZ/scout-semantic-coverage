+    def _hooks_graph_compatible(self):
+        """Graph replay skips Python, so module hooks would only fire once at
+        capture. Plain forward hooks (e.g. the coverage observer's activation
+        hook) are served from the graph instead: the hooked module's output is
+        captured as an extra graph output and the hooks are called on it after
+        each replay. Global hooks, pre-hooks and kwargs hooks fall back to
+        eager."""
+        nn_mod = torch.nn.modules.module
+        if nn_mod._global_forward_hooks or nn_mod._global_forward_pre_hooks:
+            return False
+        for m in self.net.modules():
+            if m._forward_pre_hooks or getattr(m, "_forward_hooks_with_kwargs", None):
+                return False
+        return True
+
+    @torch.no_grad()
+    def _graph_forward(self, input_data):
+        """Run self.net through a CUDA graph. Outputs are the graph's static
+        buffers, overwritten on the next call, so callers must copy them out
+        (run_step does, via .cpu()) before the next tick. Recaptured whenever
+        the set of forward hooks changes."""
+        hooked = [m for m in self.net.modules() if m._forward_hooks]
+        signature = tuple((id(m), tuple(m._forward_hooks.keys())) for m in hooked)
+        if self._graph is None or signature != self._graph_signature:
+            self._capture_graph(input_data, hooked)
+            self._graph_signature = signature
+        for k, v in input_data.items():
+            self._graph_in[k].copy_(v)
+        self._graph.replay()
+        for m, output in zip(hooked, self._graph_taps):
+            for hook in list(m._forward_hooks.values()):
+                hook(m, (), output)
+        return self._graph_out
+
+    def _capture_graph(self, input_data, hooked):
+        self._graph = None
+        self._graph_in = {k: v.clone() for k, v in input_data.items()}
+        # Swap the user hooks for taps that keep a reference to the module
+        # output; inside the graph that output is a static buffer refreshed on
+        # every replay.
+        saved = {m: m._forward_hooks for m in hooked}
+        taps = {}
+        for m in hooked:
+            m._forward_hooks = collections.OrderedDict()
+            m.register_forward_hook(lambda mod, _inp, out: taps.__setitem__(mod, out))
+        try:
+            # Warm up on a side stream (cuDNN autotune, allocator) before capture.
+            side = torch.cuda.Stream()
+            side.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(side):
+                for _ in range(3):
+                    self.net(self._graph_in)
+            torch.cuda.current_stream().wait_stream(side)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                self._graph_out = self.net(self._graph_in)
+            self._graph_taps = [taps[m] for m in hooked]
+            self._graph = graph
+        finally:
+            for m in hooked:
+                m._forward_hooks = saved[m]
+
+    def _mark(self, label):
+        """Record a phase boundary. Syncs the GPU first so a phase that ends by
+        waiting on kernels (e.g. the forward) is charged its true device time and
+        the following .cpu() does not inherit the wait."""
+        if not self._profile:
+            return
+        torch.cuda.synchronize()
+        self._prof_ts.append((label, time.perf_counter()))
+
+    def _profile_finish(self):
+        if not self._profile:
