+class _GpuRgbTransform:
+    """Same output as create_carla_rgb_transform(...)(img).unsqueeze(0).cuda(),
+    but only the PIL resize + crop run on the CPU; the uint8 crop is uploaded
+    and ToTensor/Normalize run on the GPU. Matches the CPU path to ~1e-6 and
+    does not depend on the torch CPU thread pool at all."""
+
+    def __init__(self, input_size, need_scale=True):
+        self.resize = (
+            {112: (170, 128), 128: (195, 146), 224: (341, 256), 256: (288, 288)}[input_size]
+            if need_scale
+            else None
+        )
+        self.size = input_size
+        self.mean = torch.tensor(IMAGENET_DEFAULT_MEAN, device="cuda").view(1, 3, 1, 1)
+        self.std = torch.tensor(IMAGENET_DEFAULT_STD, device="cuda").view(1, 3, 1, 1)
+
+    def __call__(self, rgb):
+        a = np.asarray(Image.fromarray(rgb).resize(self.resize)) if self.resize else rgb
+        # torchvision CenterCrop offsets
+        h, w = a.shape[:2]
+        top = int(round((h - self.size) / 2.0))
+        left = int(round((w - self.size) / 2.0))
+        a = np.ascontiguousarray(a[top:top + self.size, left:left + self.size])
+        x = torch.from_numpy(a).cuda().permute(2, 0, 1).unsqueeze(0).float().div_(255)
+        return (x - self.mean) / self.std
+
